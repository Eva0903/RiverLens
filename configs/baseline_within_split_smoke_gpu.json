{
  "project_name": "Jinjiang 01 strict within-split GPU smoke",
  "data_dir": "data/raw",
  "results_dir": "results/baseline_within_split_smoke_gpu",
  "frequency": "4h",
  "target_station": "C",
  "targets": [
    "DO"
  ],
  "target_default_windows": {
    "DO": 30,
    "NH3N": 48,
    "CODMN": 48,
    "TP": 66
  },
